# 数据库 root 密码（默认 root）
DB_PASSWORD=root

# DeepSeek API Key（AI 功能用；留空则 AI 功能不可用但服务仍可启动）
DEEPSEEK_API_KEY=

# JWT 签名密钥（≥32 字符；留空则退化为零字节密钥，仅影响登录鉴权）
LIFEARCHIVE_JWT_SECRET=

# LifeArchive 源码目录（本地开发默认 ../life；CI 里指向 clone 的 life-archive）
LIFEARCHIVE_DIR=../life

# Maven 镜像源：aliyun（国内）/ central（海外 CI）
MAVEN_MIRROR=aliyun
